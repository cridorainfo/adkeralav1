<?xml version="1.0" encoding="utf-8"?>
<!-- Same vendor-chip preference list as kiosk/serialPort.cjs's CONSOLE_VENDOR_IDS (hex -> decimal
     for Android's usb-device vendor-id attribute), for the ESP32 stop-announcement console.
     Referenced by MainActivity's USB_DEVICE_ATTACHED intent-filter meta-data so Android can
     auto-launch (or bring to front) this always-on kiosk app when the console is plugged in. -->
<resources>
    <usb-device vendor-id="12346" /> <!-- 0x303a — Espressif (ESP32 native USB) -->
    <usb-device vendor-id="4292" />  <!-- 0x10c4 — Silicon Labs CP210x -->
    <usb-device vendor-id="6790" />  <!-- 0x1a86 — WCH CH340 -->
    <usb-device vendor-id="9025" />  <!-- 0x2341 — Arduino -->
    <usb-device vendor-id="1027" />  <!-- 0x0403 — FTDI -->
</resources>
